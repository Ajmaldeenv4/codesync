{
  "name": "codesync",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @codesync/db generate",
    "db:migrate": "pnpm --filter @codesync/db migrate:dev",
    "db:deploy": "pnpm --filter @codesync/db migrate:deploy"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "catalog:",
    "prettier": "3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.2"
  }
}
