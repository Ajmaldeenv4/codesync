{
  "name": "@codesync/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"test/docker/**\"",
    "test:docker": "vitest run test/docker --no-file-parallelism"
  },
  "dependencies": {
    "@codesync/shared": "workspace:*",
    "dockerode": "5.0.1",
    "tsx": "catalog:",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.2",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
