# Copy to the repo root as .env (git-ignored). Web, collab, runner and Prisma all read it in
# local dev. In production every value comes from the platform's secret store instead.

# --- Database (docker compose postgres) ---
DATABASE_URL=postgresql://codesync:codesync@localhost:5432/codesync

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL for local dev: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 1 enables a test-only sign-in provider for Playwright. Ignored when NODE_ENV=production.
AUTH_TEST_MODE=0
# Needed for `next start` outside Vercel (Auth.js only trusts the Host header when told to).
# AUTH_TRUST_HOST=true

# --- Collab server ---
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
# Signs the short-lived WebSocket room tokens (web signs, collab verifies).
WS_TOKEN_SECRET=
# Authenticates web -> collab internal calls (history restore).
COLLAB_INTERNAL_SECRET=
# Optional: collab's HTTP address as seen from the web server. Defaults to NEXT_PUBLIC_COLLAB_URL
# with ws:// swapped for http://.
# COLLAB_INTERNAL_URL=http://localhost:1234

# --- Runner ---
RUNNER_PORT=4000
RUNNER_URL=http://localhost:4000
# HMAC key for web -> runner signed requests.
RUNNER_HMAC_KEY=
# Sandbox containers allowed at once (further runs get 503 until one finishes).
# RUNNER_MAX_CONCURRENCY=4
